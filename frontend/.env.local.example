# Next.js server-to-server backend URL. Keep API_SHARED_SECRET server-side.
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
API_SHARED_SECRET=replace-with-the-same-local-secret

# Firebase web SDK config - all safe to expose client-side (identifies
# the project, doesn't authorize anything on its own). Get these from
# Firebase console -> Project settings -> General -> Your apps -> Web app.
# Google must be enabled as a sign-in provider under Authentication ->
# Sign-in method for signInWithGoogle() to work.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-real-value
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-real-value
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-real-value
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-with-real-value
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-real-value
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-real-value
