# FastAPI backend
ATLAS_ENV=development
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_GUIDE_MODEL=gemini-3.5-flash-lite
UPLOAD_ROOT=/tmp/atlas-uploads
# Required in production. Keep the bucket private; Atlas serves authorized
# source requests through the backend.
PAPER_STORAGE_BUCKET=
API_SHARED_SECRET=replace-with-a-local-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
